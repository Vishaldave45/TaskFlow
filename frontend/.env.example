# ==============================================================================
# TaskFlow Frontend Environment Configuration Template
# Copy this file to `.env` in `frontend/` directory:
#   cp .env.example .env
# ==============================================================================

# Base URL for API requests.
# During local development with Vite proxy, leave empty or set to '/api/v1'.
# When connecting directly to a remote backend without proxy, specify full URL:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1
