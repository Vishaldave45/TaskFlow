# TaskFlow Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ─── Django Core ───────────────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (PostgreSQL) ─────────────────────────────────────────
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow
DB_HOST=localhost
DB_PORT=5432

# ─── CORS (for React frontend) ────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
