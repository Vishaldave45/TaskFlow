# ==============================================================================
# TaskFlow Backend Environment Configuration Template
# Copy this file to `.env` in the project root or `backend/` directory:
#   cp .env.example .env
# ==============================================================================

# Django Core Settings
# In production, set DEBUG=False and generate a cryptographically secure key:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-taskflow-dev-secret-key-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Matches defaults in docker-compose.yml
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow
DB_HOST=localhost
DB_PORT=5439

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
